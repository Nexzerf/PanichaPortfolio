# ── Supabase (public: safe in the browser; RLS protects the data) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical site URL for SEO, sitemap and share links
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Contact form (server only) ──
# Random string used to hash visitor IPs for rate limiting
CONTACT_HASH_SALT=change-me
# Optional: email notifications through Resend
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
